# Application Environment
PROJECT_NAME="CineMate AI"
ENVIRONMENT="development"

# PostgreSQL Database (Asyncpg for runtime, Psycopg for Alembic migrations)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cinemate"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinemate"

# Redis
REDIS_URL="redis://localhost:6379/0"
USE_FAKEREDIS_FALLBACK=true

# Security & Authentication
SECRET_KEY="cinemate-super-secret-key-change-in-production-2026-min-32-chars!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Business Logic Configuration
SEAT_HOLD_DURATION_SECONDS=600
MAX_SEATS_PER_BOOKING=10
CANCELLATION_WINDOW_HOURS=2

# Sandbox Payment Provider
PAYMENT_WEBHOOK_SECRET="cinemate_sandbox_whsec_secret_key_998877"

# Razorpay Payment Gateway (Optional, test mode available)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# AI Discovery & LLM Integration (Optional, built-in intelligent fallback active)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
